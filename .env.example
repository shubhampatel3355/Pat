# ─────────────────────────────────────────────────────────────────────────────
# Pat Michaels OS — environment variables
# Copy to .env for local development. In Coolify, set these on the application resource.
# The app validates everything at boot and refuses to start with a readable error list.
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public URL (used in emails, invite links, cookies). No trailing slash.
APP_URL=https://os.patmichaels.in
PORT=3000
# How the server reaches itself to render PDFs with Chromium (default http://127.0.0.1:$PORT).
INTERNAL_APP_URL=
LOG_LEVEL=info
TZ=Asia/Kolkata
# Optional: stable key so Server Action references survive across instances (base64, 32 bytes).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Database (PostgreSQL 17) ─────────────────────────────────────────────────
# Runtime role: DML only (see docs/DEPLOY.md → least-privilege roles).
DATABASE_URL=postgresql://pm_app:CHANGE_ME@postgres:5432/patmichaels
# Optional migration role (owner of the schema). Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
DB_POOL_MAX=10
SLOW_QUERY_MS=500

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_32_BYTES_BASE64
# Optional Google SSO (only for people who already have an account with the same email).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Session length without / with "Remember this device".
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30
# Optional: email a 6-digit code to Owners/Admins at sign-in.
AUTH_OTP_FOR_ADMINS=false

# ── Encryption (client contact PII on BD meetings) ───────────────────────────
# 32 random bytes, base64. Rotating it requires re-encrypting (see docs/RUNBOOK.md).
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# ── File storage (S3-compatible: MinIO on the VPS, or Hostinger Object Storage) ─
STORAGE_DRIVER=s3
# How the app reaches storage (internal network).
S3_ENDPOINT=http://minio:9000
# How browsers reach it: downloads redirect to 60-second presigned links on this address. Required when
# S3_ENDPOINT is an internal name; the bucket itself stays private (see docs/DEPLOY.md → MinIO).
S3_PUBLIC_ENDPOINT=https://files.patmichaels.in
S3_REGION=us-east-1
S3_BUCKET=pat-michaels-os
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# MinIO needs path-style URLs.
S3_FORCE_PATH_STYLE=true
# Server-side encryption of uploads: AES256 (SSE-S3). MinIO only accepts it once KMS is configured
# (MINIO_KMS_SECRET_KEY, see docs/DEPLOY.md). Leave empty to store without it.
S3_SSE=
UPLOAD_MAX_MB=25
# Optional ClamAV daemon for upload scanning (clamd INSTREAM).
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_FROM=Pat Michaels OS <no-reply@patmichaels.in>
# Hostinger: smtp.hostinger.com, 465, SMTP_SECURE=true · Resend: smtp.resend.com, 465, user "resend"
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@patmichaels.in
SMTP_PASSWORD=CHANGE_ME

# ── Company (printed on invoices, payslips and emails) ───────────────────────
COMPANY_LEGAL_NAME=Pat Michaels Developers LLP
COMPANY_SHORT_NAME=Pat Michaels
COMPANY_GSTIN=29AAKFP4821L1ZR
COMPANY_PAN=
COMPANY_RERA=PRM/KA/RERA/1251/310/AG/220415/002938
COMPANY_ADDRESS=14, Lavelle Road, Bengaluru 560001
COMPANY_PHONE=+91 80 4718 2200
COMPANY_EMAIL=accounts@patmichaels.in
COMPANY_WEBSITE=patmichaels.in
# Required in production — replaces the prototype's sample bank details on invoices.
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT_NAME=
COMPANY_BANK_ACCOUNT_NUMBER=
COMPANY_BANK_IFSC=
COMPANY_BANK_BRANCH=
COMPANY_SAC_CODE=9972
COMPANY_SIGNATORY_NAME=Pat Michaels
COMPANY_SIGNATORY_TITLE=Designated Partner

# ── PDF rendering ────────────────────────────────────────────────────────────
# Path to Chromium. The Docker image sets /usr/bin/chromium. Locally, leave empty to use
# an installed Chrome/Edge (channel lookup) or Playwright's browser.
CHROMIUM_PATH=

# ── Background jobs ──────────────────────────────────────────────────────────
# Run email/reminder workers inside this process (one instance should have it on).
WORKER_ENABLED=true

# ── Feature flags ────────────────────────────────────────────────────────────
# Comma-separated. "integrations-preview" lists planned integrations (WhatsApp, Calendar, Tally…) in Settings.
FEATURES=

# ── First-run seed (idempotent; runs on every container start) ────────────────
RUN_SEED_ON_START=true
SEED_OWNERS=Pat Michaels <pat@patmichaels.in>;Arjun Rao <arjun@patmichaels.in>
# Temporary owner password. Leave empty to generate one (printed once in the logs).
SEED_OWNER_PASSWORD=
SEED_TARGET_REVENUE_CR=24
SEED_TARGET_WIP_CR=1.5

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
