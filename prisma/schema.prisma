// Pat Michaels OS — data model.
// Conventions: UUIDv7 primary keys, snake_case tables/columns, money as BIGINT paise,
// timestamps in UTC (timestamptz), calendar dates as DATE (interpreted in Asia/Kolkata).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  name               String
  phone              String?
  role               Role      @default(EMPLOYEE)
  title              String?
  partnerId          String?   @map("partner_id") @db.Uuid
  dateOfJoining      DateTime? @map("date_of_joining") @db.Date
  ctcAnnualPaise     BigInt?   @map("ctc_annual_paise")
  active             Boolean   @default(true)
  passwordHash       String?   @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  sessionVersion     Int       @default(0) @map("session_version")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  achievementsSeenAt DateTime? @map("achievements_seen_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  partner User?  @relation("PartnerTeam", fields: [partnerId], references: [id], onDelete: SetNull)
  team    User[] @relation("PartnerTeam")

  authTokens         AuthToken[]
  leadBrokerships    LeadBroker[]
  leadsCreated       Lead[]          @relation("LeadCreatedBy")
  tasksAssigned      Task[]          @relation("TaskAssignee")
  tasksCreated       Task[]          @relation("TaskCreatedBy")
  taskComments       TaskComment[]
  followUps          FollowUp[]      @relation("FollowUpOwner")
  followUpsCreated   FollowUp[]      @relation("FollowUpCreatedBy")
  todos              Todo[]
  bdPrimary          BdMeeting[]     @relation("BdPrimary")
  bdSecondary        BdMeeting[]     @relation("BdSecondary")
  bdCreated          BdMeeting[]     @relation("BdCreatedBy")
  cabsFor            CabBooking[]    @relation("CabBookedFor")
  cabsCreated        CabBooking[]    @relation("CabCreatedBy")
  cabsStatusChanged  CabBooking[]    @relation("CabStatusChangedBy")
  invoicesCreated    Invoice[]       @relation("InvoiceCreatedBy")
  invoiceBrokerships InvoiceBroker[]
  paymentsRecorded   Payment[]
  ledgerEntries      LedgerEntry[]
  payrollCreated     PayrollRun[]    @relation("PayrollCreatedBy")
  payrollApproved    PayrollRun[]    @relation("PayrollApprovedBy")
  payrollDisbursed   PayrollRun[]    @relation("PayrollDisbursedBy")
  payslips           Payslip[]
  filesUploaded      File[]          @relation("FileUploadedBy")
  filesOwned         File[]          @relation("FileOwner")
  achievements       Achievement[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  permissionsUpdated Permission[]
  settingsUpdated    Setting[]

  @@index([role, active])
  @@index([partnerId])
  @@map("users")
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
  LOGIN_OTP
}

model AuthToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  attempts  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Permission {
  role        Role
  key         String
  allowed     Boolean
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([role, key])
  @@map("permissions")
}

model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// ───────────────────────────── Sell: WIP ─────────────────────────────

enum PricingBasis {
  PER_SQFT
  PER_SEAT
  LUMPSUM
}

enum LandlordType {
  LANDLORD
  OPERATOR
}

enum WipRemark {
  VISITS
  MEETINGS
  FOLLOW_UP_MEETINGS
  NEGOTIATIONS
  ON_HOLD
  LOST
  INVOICE_RAISED
  PAYMENT_COLLECTED
}

model Lead {
  id              String       @id @default(uuid(7)) @db.Uuid
  serial          Int          @unique @default(autoincrement())
  tenantName      String       @map("tenant_name")
  pricingBasis    PricingBasis @map("pricing_basis")
  areaSqft        Int?         @map("area_sqft")
  seats           Int?
  ratePaise       BigInt       @map("rate_paise")
  building        String?
  location        String
  landlordType    LandlordType @default(LANDLORD) @map("landlord_type")
  landlordName    String?      @map("landlord_name")
  estFeesPaise    BigInt       @map("est_fees_paise")
  closureDate     DateTime     @map("closure_date") @db.Date
  remark          WipRemark    @default(VISITS)
  remarkChangedAt DateTime     @default(now()) @map("remark_changed_at") @db.Timestamptz(3)
  createdById     String       @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)

  createdBy    User          @relation("LeadCreatedBy", fields: [createdById], references: [id])
  brokers      LeadBroker[]
  tasks        Task[]
  followUps    FollowUp[]
  invoices     Invoice[]
  achievements Achievement[]

  @@index([remark])
  @@index([closureDate])
  @@index([deletedAt])
  @@map("leads")
}

enum BrokerRole {
  PRIMARY
  SECONDARY
}

model LeadBroker {
  id           String     @id @default(uuid(7)) @db.Uuid
  leadId       String     @map("lead_id") @db.Uuid
  role         BrokerRole
  userId       String?    @map("user_id") @db.Uuid
  externalName String?    @map("external_name")
  sharePct     Int?       @map("share_pct")
  position     Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([leadId, userId])
  @@index([userId])
  @@map("lead_brokers")
}

// ───────────────────────────── Sell: follow-ups, tasks, to-dos ─────────────────────────────

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id             String       @id @default(uuid(7)) @db.Uuid
  title          String
  assigneeId     String       @map("assignee_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  dueAt          DateTime?    @map("due_at") @db.Timestamptz(3)
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  leadId         String?      @map("lead_id") @db.Uuid
  remindInApp    Boolean      @default(true) @map("remind_in_app")
  remindEmail    Boolean      @default(false) @map("remind_email")
  remindWhatsapp Boolean      @default(false) @map("remind_whatsapp")
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  assignee  User          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  comments  TaskComment[]

  @@index([assigneeId, status])
  @@index([dueAt])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_comments")
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SITE_VISIT
}

model FollowUp {
  id          String       @id @default(uuid(7)) @db.Uuid
  leadId      String?      @map("lead_id") @db.Uuid
  contactName String       @map("contact_name")
  ownerId     String       @map("owner_id") @db.Uuid
  createdById String       @map("created_by_id") @db.Uuid
  type        FollowUpType
  note        String?
  dueAt       DateTime     @map("due_at") @db.Timestamptz(3)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  lead      Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner     User  @relation("FollowUpOwner", fields: [ownerId], references: [id])
  createdBy User  @relation("FollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([ownerId, dueAt])
  @@map("follow_ups")
}

model Todo {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  text      String
  dueDate   DateTime? @map("due_date") @db.Date
  dueTime   String?   @map("due_time")
  important Boolean   @default(false)
  remind    Boolean   @default(false)
  note      String?
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, done])
  @@map("todos")
}

// ───────────────────────────── Sell: business development ─────────────────────────────

enum MeetingType {
  INTRODUCTION
  REQUIREMENT
  SITE_TOUR
  PROPOSAL
  FOLLOW_UP
}

enum MeetingMode {
  IN_PERSON
  VIDEO_CALL
  PHONE_CALL
}

enum LeadTemperature {
  COLD
  LUKEWARM
  WARM
  HOT
}

model BdMeeting {
  id                String          @id @default(uuid(7)) @db.Uuid
  primaryBrokerId   String          @map("primary_broker_id") @db.Uuid
  secondaryBrokerId String?         @map("secondary_broker_id") @db.Uuid
  meetingDate       DateTime        @map("meeting_date") @db.Date
  tenantName        String          @map("tenant_name")
  sector            String?
  contactName       String          @map("contact_name")
  designation       String?
  clientPhoneEnc    String?         @map("client_phone_enc")
  clientEmailEnc    String?         @map("client_email_enc")
  meetingType       MeetingType     @map("meeting_type")
  temperature       LeadTemperature
  mode              MeetingMode
  comments          String?
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)

  primaryBroker   User  @relation("BdPrimary", fields: [primaryBrokerId], references: [id])
  secondaryBroker User? @relation("BdSecondary", fields: [secondaryBrokerId], references: [id])
  createdBy       User  @relation("BdCreatedBy", fields: [createdById], references: [id])

  @@index([meetingDate])
  @@index([primaryBrokerId])
  @@index([secondaryBrokerId])
  @@map("bd_meetings")
}

// ───────────────────────────── Operate: vehicles ─────────────────────────────

enum CarType {
  SEDAN
  SUV
}

enum CabStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model CabBooking {
  id               String    @id @default(uuid(7)) @db.Uuid
  carType          CarType   @map("car_type")
  clientName       String    @map("client_name")
  pickupDate       DateTime  @map("pickup_date") @db.Date
  pickupTime       String    @map("pickup_time")
  pickupLocation   String    @map("pickup_location")
  bookedForId      String    @map("booked_for_id") @db.Uuid
  createdById      String    @map("created_by_id") @db.Uuid
  status           CabStatus @default(REQUESTED)
  statusChangedById String?  @map("status_changed_by_id") @db.Uuid
  statusChangedAt  DateTime? @map("status_changed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookedFor       User  @relation("CabBookedFor", fields: [bookedForId], references: [id])
  createdBy       User  @relation("CabCreatedBy", fields: [createdById], references: [id])
  statusChangedBy User? @relation("CabStatusChangedBy", fields: [statusChangedById], references: [id])

  @@index([pickupDate])
  @@index([bookedForId])
  @@map("cab_bookings")
}

// ───────────────────────────── Money: invoices, payments, ledger ─────────────────────────────

enum InvoiceType {
  INVOICE
  PROFORMA
  CREDIT_NOTE
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CREDITED
  OPEN
  CONVERTED
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  type            InvoiceType
  number          String        @unique
  fy              String
  seq             Int
  status          InvoiceStatus
  issueDate       DateTime      @map("issue_date") @db.Date
  dueDate         DateTime?     @map("due_date") @db.Date
  validUntil      DateTime?     @map("valid_until") @db.Date
  payeeName       String        @map("payee_name")
  billingAddress  String        @map("billing_address")
  gstin           String?
  placeOfSupply   String        @map("place_of_supply")
  narration       String?
  paymentTerms    String        @map("payment_terms")
  mobile          String
  email           String
  feesPaise       BigInt        @map("fees_paise")
  cgstPaise       BigInt        @default(0) @map("cgst_paise")
  sgstPaise       BigInt        @default(0) @map("sgst_paise")
  igstPaise       BigInt        @default(0) @map("igst_paise")
  totalPaise      BigInt        @map("total_paise")
  amountPaidPaise BigInt        @default(0) @map("amount_paid_paise")
  leadId          String?       @map("lead_id") @db.Uuid
  convertedFromId String?       @unique @map("converted_from_id") @db.Uuid
  creditNoteForId String?       @map("credit_note_for_id") @db.Uuid
  reason          String?
  pdfKey          String?       @map("pdf_key")
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead          Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  convertedFrom Invoice?        @relation("ProformaConversion", fields: [convertedFromId], references: [id])
  convertedTo   Invoice?        @relation("ProformaConversion")
  creditNoteFor Invoice?        @relation("CreditNotes", fields: [creditNoteForId], references: [id])
  creditNotes   Invoice[]       @relation("CreditNotes")
  createdBy     User            @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  brokers       InvoiceBroker[]
  payments      Payment[]
  files         File[]
  achievements  Achievement[]

  @@unique([type, fy, seq])
  @@index([type, issueDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceBroker {
  id           String   @id @default(uuid(7)) @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  externalName String?  @map("external_name")
  sharePct     Int      @map("share_pct")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([userId])
  @@map("invoice_brokers")
}

enum DocumentKind {
  INVOICE
  PROFORMA
  CREDIT_NOTE
}

model DocumentSequence {
  kind      DocumentKind
  fy        String
  nextValue Int          @default(1) @map("next_value")
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([kind, fy])
  @@map("document_sequences")
}

enum PaymentMode {
  NEFT
  RTGS
  IMPS
  UPI
  CHEQUE
  CARD
  CASH
  OTHER
}

model Payment {
  id           String      @id @default(uuid(7)) @db.Uuid
  invoiceId    String      @map("invoice_id") @db.Uuid
  amountPaise  BigInt      @map("amount_paise")
  receivedOn   DateTime    @map("received_on") @db.Date
  mode         PaymentMode
  reference    String?
  notes        String?
  recordedById String      @map("recorded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  ledgerEntry  LedgerEntry?

  @@index([invoiceId])
  @@index([receivedOn])
  @@map("payments")
}

enum LedgerType {
  INCOME
  EXPENSE
}

model LedgerEntry {
  id           String      @id @default(uuid(7)) @db.Uuid
  type         LedgerType
  category     String
  description  String
  party        String?
  mode         PaymentMode
  amountPaise  BigInt      @map("amount_paise")
  entryDate    DateTime    @map("entry_date") @db.Date
  paymentId    String?     @unique @map("payment_id") @db.Uuid
  payrollRunId String?     @map("payroll_run_id") @db.Uuid
  createdById  String      @map("created_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(3)

  payment    Payment?    @relation(fields: [paymentId], references: [id])
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])

  @@index([type, entryDate])
  @@map("ledger_entries")
}

// ───────────────────────────── Money: payroll ─────────────────────────────

enum PayrollRunStatus {
  REVIEW
  APPROVED
  DISBURSED
}

enum PayslipPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

model PayrollRun {
  id            String           @id @default(uuid(7)) @db.Uuid
  period        String           @unique
  status        PayrollRunStatus @default(REVIEW)
  payDate       DateTime         @map("pay_date") @db.Date
  createdById   String           @map("created_by_id") @db.Uuid
  approvedById  String?          @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?        @map("approved_at") @db.Timestamptz(3)
  disbursedById String?          @map("disbursed_by_id") @db.Uuid
  disbursedAt   DateTime?        @map("disbursed_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User          @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?         @relation("PayrollApprovedBy", fields: [approvedById], references: [id])
  disbursedBy   User?         @relation("PayrollDisbursedBy", fields: [disbursedById], references: [id])
  payslips      Payslip[]
  ledgerEntries LedgerEntry[]

  @@map("payroll_runs")
}

model Payslip {
  id              String            @id @default(uuid(7)) @db.Uuid
  runId           String            @map("run_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  period          String
  periodType      PayslipPeriodType @default(MONTHLY) @map("period_type")
  grossPaise      BigInt            @map("gross_paise")
  deductionsPaise BigInt            @map("deductions_paise")
  netPaise        BigInt            @map("net_paise")
  components      Json
  onHold          Boolean           @default(false) @map("on_hold")
  pdfKey          String?           @map("pdf_key")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id])

  @@unique([userId, period, periodType])
  @@index([runId])
  @@map("payslips")
}

// ───────────────────────────── Admin: vault ─────────────────────────────

enum FolderKey {
  PM_DOCUMENTS
  CLIENT_DOCUMENTS
  EMPLOYEE_DOCUMENTS
}

enum ScanStatus {
  CLEAN
  SKIPPED
  INFECTED
}

model Folder {
  id        String    @id @default(uuid(7)) @db.Uuid
  key       FolderKey @unique
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  files File[]

  @@map("folders")
}

model File {
  id           String     @id @default(uuid(7)) @db.Uuid
  folderId     String?    @map("folder_id") @db.Uuid
  name         String
  storageKey   String     @unique @map("storage_key")
  sizeBytes    Int        @map("size_bytes")
  mime         String
  sha256       String
  ownerUserId  String?    @map("owner_user_id") @db.Uuid
  invoiceId    String?    @map("invoice_id") @db.Uuid
  uploadedById String     @map("uploaded_by_id") @db.Uuid
  scanStatus   ScanStatus @default(SKIPPED) @map("scan_status")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)

  folder     Folder?  @relation(fields: [folderId], references: [id])
  owner      User?    @relation("FileOwner", fields: [ownerUserId], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  uploadedBy User     @relation("FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([folderId, deletedAt])
  @@index([ownerUserId])
  @@index([invoiceId])
  @@map("files")
}

// ───────────────────────────── Targets, achievements, notifications ─────────────────────────────

enum TargetScope {
  COMPANY
  PARTNER
  USER
}

enum TargetMetric {
  REVENUE
  WIP_FEES
}

model Target {
  id          String       @id @default(uuid(7)) @db.Uuid
  scope       TargetScope
  scopeKey    String       @map("scope_key")
  metric      TargetMetric
  period      String
  amountPaise BigInt       @map("amount_paise")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([scope, scopeKey, metric, period])
  @@map("targets")
}

enum AchievementKind {
  DEAL_CLOSED
  TARGET_REACHED
  MILESTONE
}

model Achievement {
  id         String          @id @default(uuid(7)) @db.Uuid
  kind       AchievementKind
  userId     String?         @map("user_id") @db.Uuid
  leadId     String?         @map("lead_id") @db.Uuid
  invoiceId  String?         @map("invoice_id") @db.Uuid
  title      String
  meta       String?
  valuePaise BigInt?         @map("value_paise")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("achievements")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  text      String
  href      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ───────────────────────────── Audit & settings ─────────────────────────────

enum AuditVisibility {
  PUBLIC
  RESTRICTED
  PRIVATE
}

model AuditLog {
  id             String          @id @default(uuid(7)) @db.Uuid
  actorId        String?         @map("actor_id") @db.Uuid
  actorName      String          @map("actor_name")
  module         String
  action         String
  entityType     String?         @map("entity_type")
  entityId       String?         @map("entity_id")
  text           String
  ip             String?
  userAgent      String?         @map("user_agent")
  before         Json?
  after          Json?
  visibility     AuditVisibility @default(PRIVATE)
  subjectUserIds String[]        @default([]) @map("subject_user_ids") @db.Uuid
  feed           Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([feed, createdAt])
  @@index([subjectUserIds], type: Gin)
  @@map("audit_logs")
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}
